{
  "type": "record",
  "name": "PurchaseReservationReleasedV1",
  "namespace": "com.philia.flashsale.contract.purchase.event.v1",
  "doc": "Durable current-state fact that a purchase reservation cannot be confirmed.",
  "fields": [
    {"name": "eventId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "eventType", "type": "string", "doc": "PurchaseReservationReleased"},
