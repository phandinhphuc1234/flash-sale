{
  "type": "record",
  "name": "OrderCreatedV2",
  "namespace": "com.philia.flashsale.contract.order.event.v2",
  "doc": "Order-owned immutable accepted regular purchase fact; existing V1 Flash Sale facts are unchanged.",
  "fields": [
    {"name": "eventId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "eventType", "type": "string", "doc": "OrderCreated"},
    {"name": "eventVersion", "type": "int", "doc": "2"},
    {"name": "producer", "type": "string", "doc": "order-service"},
    {"name": "aggregateType", "type": "string", "doc": "ORDER"},
    {"name": "aggregateId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "aggregateVersion", "type": "long"},
    {"name": "correlationId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "causationId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "occurredAt", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "traceparent", "type": ["null", "string"], "default": null, "doc": "Nullable bounded W3C traceparent."},
    {"name": "tracestate", "type": ["null", "string"], "default": null, "doc": "Nullable bounded W3C tracestate."},
    {"name": "data", "type": {"type": "record", "name": "OrderCreatedDataV2", "fields": [
      {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}},
      {"name": "orderNumber", "type": "string"},
      {"name": "purchaseRequestId", "type": {"type": "string", "logicalType": "uuid"}},
      {"name": "userId", "type": {"type": "string", "logicalType": "uuid"}},
      {"name": "purchaseSource", "type": "string", "doc": "BUY_NOW or CART."},
      {"name": "stockParticipantType", "type": "string", "doc": "REGULAR_STOCK_HOLD"},
      {"name": "stockReferenceId", "type": {"type": "string", "logicalType": "uuid"}},
      {"name": "cartId", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null},
      {"name": "cartVersion", "type": ["null", "long"], "default": null},
      {"name": "status", "type": "string", "doc": "PENDING_PAYMENT"},
      {"name": "currency", "type": "string", "doc": "Uppercase ISO-style three-letter currency."},
      {"name": "subtotalAmount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 4}},
      {"name": "totalAmount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 4}},
      {"name": "acceptedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}},
      {"name": "stockHoldExpiresAt", "type": {"type": "long", "logicalType": "timestamp-millis"}},
      {"name": "paymentDeadline", "type": {"type": "long", "logicalType": "timestamp-millis"}},
      {"name": "items", "type": {"type": "array", "items": {"type": "record", "name": "OrderCreatedItemV2", "fields": [
        {"name": "variantId", "type": {"type": "string", "logicalType": "uuid"}},
        {"name": "quantity", "type": "long"},
        {"name": "unitPrice", "type": {"type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 4}},
        {"name": "lineAmount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 4}},
        {"name": "productId", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null},
        {"name": "skuSnapshot", "type": ["null", "string"], "default": null},
        {"name": "displayNameSnapshot", "type": ["null", "string"], "default": null}
      ]}}}
    ]}}
  ]
}
