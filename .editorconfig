root = true

# =========================================================
# Default rules for the whole Flash Sale Engine repository
# =========================================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# =========================================================
# Java
# =========================================================

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

# =========================================================
# Gradle
# =========================================================

[*.gradle]
indent_style = space
indent_size = 4

[*.gradle.kts]
indent_style = space
indent_size = 4
max_line_length = 120

[gradlew]
end_of_line = lf

[gradlew.bat]
end_of_line = crlf

# =========================================================
# Maven / XML
# =========================================================

[*.xml]
indent_style = space
indent_size = 4

[pom.xml]
indent_style = space
indent_size = 4

# =========================================================
# Spring Boot configuration
# =========================================================

[*.properties]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# =========================================================
# SQL / Flyway
# =========================================================

[*.sql]
indent_style = space
indent_size = 4
max_line_length = 120

# =========================================================
# Docker
# =========================================================

[Dockerfile]
indent_style = space
indent_size = 4

[Dockerfile.*]
indent_style = space
indent_size = 4

[docker-compose*.{yml,yaml}]
indent_style = space
indent_size = 2

# =========================================================
# Kubernetes / Helm
# =========================================================

[k8s/**/*.{yml,yaml}]
indent_style = space
indent_size = 2

[kubernetes/**/*.{yml,yaml}]
indent_style = space
indent_size = 2

[helm/**/*.{yml,yaml}]
indent_style = space
indent_size = 2

[charts/**/*.{yml,yaml}]
indent_style = space
indent_size = 2

# =========================================================
# GitHub Actions
# =========================================================

[.github/workflows/*.{yml,yaml}]
indent_style = space
indent_size = 2

# =========================================================
# Shell scripts
# =========================================================

[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

[*.bash]
indent_style = space
indent_size = 2
end_of_line = lf

# =========================================================
# PowerShell
# =========================================================

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = lf

[*.psm1]
indent_style = space
indent_size = 4
end_of_line = lf

# =========================================================
# Markdown / Spec Kit
# =========================================================

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# =========================================================
# JSON
# =========================================================

[*.json]
indent_style = space
indent_size = 2

[*.jsonc]
indent_style = space
indent_size = 2

# =========================================================
# Makefile requires tabs
# =========================================================

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# =========================================================
# Generated / lock files
# =========================================================

[*.lock]
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset