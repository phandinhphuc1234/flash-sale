# Flash Sale local Docker Compose defaults.
# Copy this file to infra/docker/.env for local overrides.
# Real .env files are ignored by git.

COMPOSE_PROJECT_NAME=flash-sale

# Platform images. These are local-development defaults, not production pinning policy.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
KAFKA_IMAGE=apache/kafka:4.0.0
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:8.3.0
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0

# Host ports for local tools and IDE-run services.
GATEWAY_PORT=8080
GATEWAY_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=29092
SCHEMA_REGISTRY_HOST_PORT=8081
KAFKA_UI_HOST_PORT=8088

# Local PostgreSQL bootstrap account.
# Replace in infra/docker/.env for your own machine if needed.
POSTGRES_USER=flashsale
# Replace with a unique random password before starting the stack.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=flashsale_admin

# Bind backing services to loopback. Do not expose them publicly on a VPS.
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
KAFKA_BIND_ADDRESS=127.0.0.1
SCHEMA_REGISTRY_BIND_ADDRESS=127.0.0.1
KAFKA_UI_BIND_ADDRESS=127.0.0.1

# Application image names.
API_GATEWAY_IMAGE=flash-sale/api-gateway:local
AUTHENTICATION_SERVICE_IMAGE=flash-sale/authentication-service:local
PRODUCT_SERVICE_IMAGE=flash-sale/product-service:local
CAMPAIGN_SERVICE_IMAGE=flash-sale/campaign-service:local
FLASHSALE_SERVICE_IMAGE=flash-sale/flashsale-service:local
ORDER_SERVICE_IMAGE=flash-sale/order-service:local
PAYMENT_SERVICE_IMAGE=flash-sale/payment-service:local
NOTIFICATION_SERVICE_IMAGE=flash-sale/notification-service:local
INVENTORY_SERVICE_IMAGE=flash-sale/inventory-service:local
CART_SERVICE_IMAGE=flash-sale/cart-service:local

# Spring container defaults.
SPRING_PROFILES_ACTIVE=docker
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Gateway Redis rate limiter.
# Keep disabled by default. Copy this file to infra/docker/.env and set a real
# Base64 value generated from at least 32 random bytes before enabling.
GATEWAY_RATE_LIMIT_ENABLED=false
RATE_LIMIT_ENVIRONMENT=docker
RATE_LIMIT_KEY_HMAC_SECRET=REPLACE_WITH_BASE64_SECRET_AT_LEAST_32_RANDOM_BYTES

# Redis authentication. This value is required by Compose and must be changed.
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD

# Authentication JWT trust contract. Replace the public-key placeholder with a
# PEM-encoded RSA public key. Keep the matching private key outside the repo.
JWT_ISSUER_URI=http://authentication-service:8080
JWT_ISSUER=http://authentication-service:8080
JWT_AUDIENCE=flash-sale-api
JWT_KEY_ID=local-dev-1
# Leave PEM values empty when using the read-only mounted key directory below.
JWT_PUBLIC_KEY_PEM=
JWT_PRIVATE_KEY_PEM=
JWT_JWK_SET_URI=http://authentication-service:8080/.well-known/jwks.json
PRODUCT_LIQUIBASE_ENABLED=false
AUTH_LIQUIBASE_ENABLED=false
INVENTORY_LIQUIBASE_ENABLED=false
CAMPAIGN_LIQUIBASE_ENABLED=false

# Campaign service-to-service OAuth2, HTTP destinations, and Kafka/Schema Registry.
# Keep the client secret out of git and replace this placeholder in infra/docker/.env.
CAMPAIGN_CLIENT_ID=campaign-service
CAMPAIGN_CLIENT_SECRET=REPLACE_WITH_CAMPAIGN_CLIENT_SECRET
INTERNAL_JWT_AUDIENCE=flash-sale-internal-api
OAUTH_TOKEN_URI=http://authentication-service:8080/oauth2/token
PRODUCT_SERVICE_URL=http://product-service:8080
INVENTORY_SERVICE_URL=http://inventory-service:8080
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
# Production and shared local profiles use controlled registration.
KAFKA_AUTO_REGISTER_SCHEMAS=false

# Authentication session settings. Keep the private key in the mounted directory,
# never in this file or in a container image.
AUTH_JWT_KEY_DIR=C:/absolute/path/to/auth-jwt
AUTH_JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/auth-jwt/jwt-public.pem
AUTH_JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/auth-jwt/jwt-private.pem
AUTH_THROTTLE_HMAC_SECRET=REPLACE_WITH_SEPARATE_BASE64_SECRET_AT_LEAST_32_RANDOM_BYTES
AUTH_TRUSTED_ORIGINS=http://localhost:3000
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTHENTICATION_SERVICE_URL=http://authentication-service:8080

# Optional development override ports for direct service debugging.
AUTHENTICATION_SERVICE_PORT=18081
PRODUCT_SERVICE_PORT=18082
CAMPAIGN_SERVICE_PORT=18083
FLASHSALE_SERVICE_PORT=18084
ORDER_SERVICE_PORT=18085
PAYMENT_SERVICE_PORT=18086
NOTIFICATION_SERVICE_PORT=18087
INVENTORY_SERVICE_PORT=18088
CART_SERVICE_PORT=18089
