{
  "type": "record",
  "name": "RegularStockHoldConfirmedV1",
  "namespace": "com.philia.flashsale.contract.regularhold.event.v1",
  "doc": "Inventory-owned fact that a regular stock hold was confirmed after payment.",
  "fields": [
    {"name": "eventId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "eventType", "type": "string", "doc": "RegularStockHoldConfirmed"},
    {"name": "eventVersion", "type": "int", "doc": "1"},
    {"name": "producer", "type": "string", "doc": "inventory-service"},
    {"name": "aggregateType", "type": "string", "doc": "REGULAR_STOCK_HOLD"},
    {"name": "aggregateId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "aggregateVersion", "type": "long"},
    {"name": "correlationId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "causationId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "occurredAt", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "traceparent", "type": ["null", "string"], "default": null, "doc": "Nullable bounded W3C traceparent."},
    {"name": "tracestate", "type": ["null", "string"], "default": null, "doc": "Nullable bounded W3C tracestate."},
    {"name": "data", "type": {"type": "record", "name": "RegularStockHoldConfirmedDataV1", "fields": [
      {"name": "holdId", "type": {"type": "string", "logicalType": "uuid"}},
      {"name": "purchaseRequestId", "type": {"type": "string", "logicalType": "uuid"}},
      {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}},
      {"name": "status", "type": "string", "doc": "CONFIRMED"},
      {"name": "items", "type": {"type": "array", "items": {"type": "record", "name": "RegularStockHoldConfirmedItemV1", "fields": [
        {"name": "variantId", "type": {"type": "string", "logicalType": "uuid"}},
        {"name": "quantity", "type": "long"}
      ]}}},
      {"name": "paymentId", "type": {"type": "string", "logicalType": "uuid"}},
      {"name": "transitionedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}}
    ]}}
  ]
}
